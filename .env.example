# =============================================================================
# Stylevique frontend environment variables
# =============================================================================
# Copy this file to `.env.local` (or `.env`) and fill in your own values.
# NEVER commit real secrets. `.env*` files are ignored except this example.
#
# The Express backend has its own .env file. These variables belong to the
# Next.js app only. The MongoDB database name must match the backend DB_NAME.
# =============================================================================

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Public origin of this Next.js app. Used by the browser auth client.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public origin of the Express API. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Origin Better Auth uses on the server. Normally the same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# A long random string. Generate one with:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth credentials from Google Cloud Console.
# Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Better Auth writes users and sessions to the same MongoDB database the
# Express API reads. Use the same cluster/database as the backend.
MONGODB_URI=mongodb://127.0.0.1:27017/stylevique

# Optional. Defaults to "stylevique" in src/lib/auth.ts.
# It must match the backend's DB_NAME.
MONGODB_DB_NAME=stylevique

# -----------------------------------------------------------------------------
# Stripe (frontend)
# -----------------------------------------------------------------------------
# This frontend redirects to Stripe-hosted Checkout, so the publishable key is
# not required by the current code. Keep it if you later add Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# The secret key and webhook secret belong to the Express backend's .env,
# never to this frontend.
