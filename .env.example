
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional homepage hero image. Any public https:// image URL works; leave it
# empty to use the bundled salon photo in public/images/banners.
NEXT_PUBLIC_HERO_IMAGE_URL=

# Origin Better Auth uses on the server. Normally the same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3000

BETTER_AUTH_SECRET=replace-with-a-long-random-secret

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Better Auth writes users and sessions to the same MongoDB database the
# Express API reads. Use the same cluster/database as the backend.
MONGODB_URI=mongodb://127.0.0.1:27017/stylevique

# Optional. Defaults to "stylevique" in src/lib/auth.ts.
# It must match the backend's DB_NAME.
MONGODB_DB_NAME=stylevique

# -----------------------------------------------------------------------------
# Stripe (frontend)
# -----------------------------------------------------------------------------
# This frontend redirects to Stripe-hosted Checkout, so the publishable key is
# not required by the current code. Keep it if you later add Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# The secret key and webhook secret belong to the Express backend's .env,
# never to this frontend.
